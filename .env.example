# ═══════════════════════════════════════════
# MONGODB (state tracking only — 512MB free)
# ═══════════════════════════════════════════
MONGO_URI=
MONGO_DB_NAME=aiko_state

# ═══════════════════════════════════════════
# GITHUB (data → Releases me upload)
# Public repo, data → GitHub Releases
# Token scope: repo + contents:write
# ═══════════════════════════════════════════
GITHUB_TOKEN=
GITHUB_REPO=yourusername/aiko-dataset

# ═══════════════════════════════════════════
# EMAIL NOTIFICATIONS
# ═══════════════════════════════════════════
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# ═══════════════════════════════════════════
# CONFIG
# ═══════════════════════════════════════════
DAILY_TARGET=6700
BATCH_SIZE=100
TEMPERATURE=1.1
MAX_RETRIES=3
TURNS_PREFERRED=16